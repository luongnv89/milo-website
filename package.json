{
  "name": "landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .vite-ssr && node scripts/prerender.mjs && node scripts/well-known.mjs",
    "preview": "vite preview",
    "verify": "npm test && npm run build",
    "test": "node --test tests/*.test.mjs",
    "agent-card:verify": "node scripts/verify-agent-card.mjs",
    "auth-md:verify": "node scripts/verify-auth-md.mjs",
    "api-catalog:publish": "node scripts/publish-api-catalog.mjs",
    "api-catalog:verify": "node scripts/verify-api-catalog.mjs",
    "dns-aid:publish": "node scripts/publish-dns-aid.mjs",
    "dns-aid:verify": "node scripts/verify-dns-aid.mjs",
    "link-headers:publish": "node scripts/publish-link-headers.mjs",
    "link-headers:verify": "node scripts/verify-link-headers.mjs",
    "markdown-negotiation:publish": "node scripts/publish-markdown-negotiation.mjs",
    "markdown-negotiation:verify": "node scripts/verify-markdown-negotiation.mjs",
    "mcp-server-card:verify": "node scripts/verify-mcp-server-card.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.553.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/vite": "^4.1.17",
    "@vitejs/plugin-react": "^5.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "vite": "^7.2.2"
  }
}
